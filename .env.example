# ─── Environment — Career AI ─────────────────────────────────────
# Copie para .env e preencha os valores

# ─── DATABASE ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=careeraiSecret123!

# ─── REDIS ────────────────────────────────────────────────────────
REDIS_PASSWORD=redisSecret123!

# ─── RABBITMQ ─────────────────────────────────────────────────────
RABBITMQ_USER=careerai
RABBITMQ_PASSWORD=rabbitSecret123!

# ─── JWT ──────────────────────────────────────────────────────────
# IMPORTANTE: Gere uma chave segura com: openssl rand -base64 64
JWT_SECRET=career-ai-jwt-secret-key-minimum-256-bits-please-change-in-production!
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ─── AI PROVIDERS ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GOOGLE_GEMINI_API_KEY=...
AI_DEFAULT_PROVIDER=openai
GEMINI_ENABLED=false

# ─── OAUTH2 — Google ──────────────────────────────────────────────
# Obter em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ─── OAUTH2 — GitHub ──────────────────────────────────────────────
# Obter em: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...

# ─── OAUTH2 — LinkedIn ────────────────────────────────────────────
# Obter em: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...

# ─── EMAIL ────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@career-ai.com
MAIL_PASSWORD=...

# ─── FRONTEND ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ─── OBSERVABILITY ────────────────────────────────────────────────
GRAFANA_PASSWORD=admin123!
ZIPKIN_HOST=localhost
ZIPKIN_PORT=9411

# ─── FEATURE FLAGS ────────────────────────────────────────────────
FEATURE_ELASTICSEARCH=false
FEATURE_QDRANT=false
FEATURE_KAFKA=false
FEATURE_GAMIFICATION=true
FEATURE_RAG=true

# ─── SPRING ───────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ─── AWS (produção) ───────────────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=career-ai-uploads
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
